        "jsCode": "const body = $input.first().json.body ?? {};\nconst contactName = String(body.contact_name ?? body.contactName ?? '').trim();\nconst nameParts = contactName.split(/\\s+/).filter(Boolean);\nconst firstName = String(body.firstName ?? (nameParts.length > 1 ? nameParts.slice(0, -1).join(' ') : nameParts[0] ?? '')).trim();\nconst lastName = String(body.lastName ?? (nameParts.length > 1 ? nameParts[nameParts.length - 1] : '')).trim();\nconst rawEmail = String(body.sender_email ?? body.email ?? '').trim();\nconst emailMatch = rawEmail.match(/<([^>]+)>/);\nconst email = (emailMatch?.[1] ?? rawEmail).trim().toLowerCase();\nconst company = String(body.org_name ?? body.company ?? '').trim();\nconst domain = String(body.sender_domain ?? (email.includes('@') ? email.split('@')[1] : '')).trim().toLowerCase();\nreturn [{ json: { leadId: String(body.leadId ?? body.id ?? '').trim(), contact_name: contactName, org_name: company, sender_email: email, sender_domain: domain, firstName, lastName, email, company, emailDomain: domain, previous_match_reason: String(body.match_reason ?? body.reason ?? '').trim() } }];"
